POSTGRES_DB=curation
POSTGRES_USER=curation
POSTGRES_PASSWORD=dev-only-change-me

# GPU FlatBuffer conversion reuses the worker image built by data_foundry_platform.
FB_CONVERTER_IMAGE=data_foundry-conversion-worker:latest
# Optional model override; normally read from /proc/driver/nvidia/gpus.
# FB_CONVERTER_GPU_MODEL=NVIDIA GeForce RTX 5090
# auto: RTX 5090=3/3, RTX 4090=3/2, other GPUs=1/1.
# Set positive integers to override the selected profile.
FB_CONVERTER_PARALLEL=auto
FB_CONVERTER_NVENC_PARALLEL=auto
